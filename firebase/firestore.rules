rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function esPropietario(uid) {
      return estaAutenticado() && request.auth.uid == uid;
    }

    function esAdministrador() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rolId == 'ADMINISTRADOR';
    }

    match /roles/{rolId} {
      allow read: if estaAutenticado();
      allow write: if esAdministrador();
    }

    match /usuarios/{uid} {
      // El registro exige aceptar los términos y siempre crea una cuenta ADOPTANTE
      allow create: if esPropietario(uid)
        && request.resource.data.uid == uid
        && request.resource.data.rolId == 'ADOPTANTE'
        && request.resource.data.terminosAceptados == true;

      allow read: if esPropietario(uid) || esAdministrador();

      // El usuario puede editar sus datos, pero no su rol ni el estado de su cuenta
      allow update: if esAdministrador()
        || (
          esPropietario(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.rolId == resource.data.rolId
          && request.resource.data.estadoCuenta == resource.data.estadoCuenta
        );

      allow delete: if esAdministrador();
    }

    // Campañas de donación: las lee cualquier usuario con sesión, las gestiona un administrador
    match /campanas/{campanaId} {
      allow read: if estaAutenticado();

      allow create: if esAdministrador()
        && request.resource.data.titulo is string
        && request.resource.data.titulo.size() > 0
        && request.resource.data.descripcion is string
        && request.resource.data.meta is number
        && request.resource.data.meta > 0;

      allow update, delete: if esAdministrador();
    }

    // Documentos (certificados de mascotas y documentos de adoptantes).
    //   documentos/{id}                    -> datos del documento
    //   documentos/{id}/contenido/archivo  -> archivo en Base64
    // Límite de 700 KB por archivo (716800 bytes); el Base64 ocupa unos 960000 caracteres.
    match /documentos/{docId} {
      // Certificados de mascotas: los ve cualquier usuario con sesión.
      // Documentos de un adoptante: solo su dueño y los administradores.
      allow read: if estaAutenticado() && (
        resource.data.propietarioTipo == 'MASCOTA'
        || resource.data.propietarioId == request.auth.uid
        || esAdministrador()
      );

      // Mascotas: solo administradores. Adoptantes: solo en su propio nombre.
      allow create: if estaAutenticado()
        && request.resource.data.subidoPor == request.auth.uid
        && request.resource.data.tamanoBytes is number
        && request.resource.data.tamanoBytes <= 716800
        && (
          (request.resource.data.propietarioTipo == 'MASCOTA' && esAdministrador())
          || (request.resource.data.propietarioTipo == 'USUARIO'
              && request.resource.data.propietarioId == request.auth.uid)
        );

      allow update: if false;

      allow delete: if estaAutenticado() && (
        esAdministrador()
        || (resource.data.propietarioTipo == 'USUARIO'
            && resource.data.propietarioId == request.auth.uid)
      );

      match /contenido/{archivoId} {
        allow read: if estaAutenticado() && (
          get(/databases/$(database)/documents/documentos/$(docId)).data.propietarioTipo == 'MASCOTA'
          || get(/databases/$(database)/documents/documentos/$(docId)).data.propietarioId == request.auth.uid
          || esAdministrador()
        );

        // Se crea en el mismo lote que el documento padre (por eso getAfter)
        allow create: if estaAutenticado()
          && archivoId == 'archivo'
          && getAfter(/databases/$(database)/documents/documentos/$(docId)).data.subidoPor == request.auth.uid
          && request.resource.data.datos is string
          && request.resource.data.datos.size() <= 960000;

        allow update: if false;

        allow delete: if estaAutenticado() && (
          esAdministrador()
          || (get(/databases/$(database)/documents/documentos/$(docId)).data.propietarioTipo == 'USUARIO'
              && get(/databases/$(database)/documents/documentos/$(docId)).data.propietarioId == request.auth.uid)
        );
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
